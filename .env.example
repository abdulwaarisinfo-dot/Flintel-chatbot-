# Copy to .env and fill in. NEVER commit a real .env (it is git-ignored). Placeholders only.

# ── Core ────────────────────────────────────────────────────────────────────
SESSION_SECRET_KEY=generate-with-python-c-"import secrets; print(secrets.token_hex(32))"
SITE_URL=https://your-domain.example
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true
MONGODB3=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true
MONGODB_DB=your_database_name
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ── Plans / credits (optional; defaults shown) ──────────────────────────────
# FREE_MONTHLY_CREDITS=40
# PLAN_CREDITS_STANDARD=400
# PLAN_CREDITS_BUSINESS=1500

# ── Billing: Lemon Squeezy (all five are required for checkout + webhooks) ──
# Dashboard -> Settings -> API: create an API key (use a TEST-mode key while testing).
LEMONSQUEEZY_API_KEY=your-lemon-squeezy-api-key
# Dashboard -> Settings -> Stores: the numeric store id.
LEMONSQUEEZY_STORE_ID=123456
# Dashboard -> Products: the numeric VARIANT id of each monthly subscription variant.
#   Standard = $19 / month, Business = $59 / month (the price is set in Lemon Squeezy, not here).
LEMONSQUEEZY_VARIANT_ID_STANDARD=111111
LEMONSQUEEZY_VARIANT_ID_BUSINESS=222222
# Dashboard -> Settings -> Webhooks: the "signing secret" you typed when creating the webhook.
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
# Exactly "true" = test mode only (test-mode checkouts and webhooks accepted, live ones ignored).
# Anything else / unset = live mode only.
LEMONSQUEEZY_TEST_MODE=true

# ── Guest search limit (optional; defaults shown) ───────────────────────────
# Credits a visitor who is not signed in may use in total (0 = gate off). Default 5. Takes precedence over GUEST_SEARCH_LIMIT.
# GUEST_CREDIT_ALLOWANCE=5
# Legacy rule: completed searches per visitor (0 = off). Used only when GUEST_CREDIT_ALLOWANCE is unset and this is set.
# GUEST_SEARCH_LIMIT=1
# Seconds before an unfinished guest search stops blocking the next one.
# GUEST_INFLIGHT_STALE_SECONDS=900
# Lifetime of the signed guest-identity cookie, in days (browsers cap cookies at 400).
# GUEST_ID_COOKIE_MAX_AGE_DAYS=400

# ── E-mail sign-up codes (REQUIRED for e-mail sign-up; placeholders only) ───
# Sign-up e-mails a 6-digit code before an account is created. Any SMTP provider works. With nothing set, e-mail sign-up
# answers "temporarily unavailable" (Google sign-in is unaffected) - it never creates an unverified account.
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# "Flintel <no-reply@your-domain.example>" - the domain must be verified with your provider (SPF/DKIM) to reach inboxes.
# EMAIL_FROM=no-reply@your-domain.example
# Port 465 uses implicit SSL automatically; otherwise STARTTLS is used. Override with SMTP_USE_SSL / SMTP_USE_TLS (true/false).
# LOCAL DEVELOPMENT ONLY: EMAIL_BACKEND=console writes the code to the server log instead of sending it (refused when SITE_URL is https).
