# FLINTEL STAGING - names and placeholders only. NEVER put production values here. Copy to the staging host's secret store, not to git.
FLINTEL_ENV=staging                       # required: the preflight refuses to run without it
# Operator-supplied proof of isolation (the preflight fails closed without them):
STAGING_FORBIDDEN_HOSTS=prod-db.example.com,flintel.example.com     # comma list: hostnames / db names that are PRODUCTION
STAGING_FORBIDDEN_KEY_SHA256_PREFIXES=                               # comma list: first 12 hex of sha256 of each PRODUCTION secret (never the secret)

SESSION_SECRET_KEY=generate-a-new-one-for-staging
MONGODB_URI=mongodb+srv://STAGING_USER:STAGING_PASSWORD@STAGING_HOST/?retryWrites=true
MONGODB3=mongodb+srv://STAGING_USER:STAGING_PASSWORD@STAGING_HOST/?retryWrites=true
MONGODB_DB=flintel_staging
GOOGLE_CLIENT_ID=staging-oauth-client-id            # a SEPARATE OAuth client whose redirect URI is the staging URL only
GOOGLE_CLIENT_SECRET=staging-oauth-client-secret
# ANTHROPIC_API_KEY is deprecated and unused: do not set it.
OPENAI_API_KEY=staging-project-key-with-a-hard-budget-limit   # the ONLY LLM + embedding key the app uses

# Billing: provider TEST mode only (searches and credits need no provider; only plan upgrades do)
LEMONSQUEEZY_TEST_MODE=true

# Cost controls (the preflight REQUIRES both to be explicit)
TRENDING_KEYWORDS_ENABLED=false           # the 12-hourly scheduler makes a paid LLM web-search call + a Google call; off in staging
LAZY_EMBED_ENABLED=0                      # default is on: unembedded posts would be embedded (paid) at query time
STAGING_OPENAI_LIMIT_CONFIRMED=false      # set true ONLY after creating the OpenAI project with a hard budget limit (needed for --phase paid)
TRUSTED_HOSTS=your-staging-host.example.net   # the hostname(s) this app answers to (include the SITE_URL host); other Host headers get 400
TRUSTED_PROXY_HOPS=1                      # reverse proxies you control in front of the app (X-Forwarded-For hops from the right)
ORIGIN_CHECK_ENABLED=true                 # require a same-origin Origin on state-changing requests
SESSION_COOKIE_SECURE=true                # the session cookie must only travel over HTTPS (the preflight requires it)
SITE_URL=https://your-staging-host.example.net   # required: OAuth redirect + https detection

# Feature flags under test
HACKERNEWS_ENABLED=true
SIGNAL_REPORT_ENABLED=true

# MySQL (optional). Keep the probe OFF until tools/staging_verify.py --mysql-probe has been reviewed on the staging database.
MYSQL_READ_ENABLED=false
ZERO_RESULT_MYSQL_PROBE_ENABLED=false
